[
    {
        "name": "place_order",
        "description": "Размещает ордер на Bybit через pybit с учётом суммы в USDT, типа сделки, TP/SL и типа ордера.",
        "parameters": {
            "type": "object",
            "properties": {
                "operation_type": {
                    "type": "string",
                    "enum": ["Buy", "Sell"],
                    "description": "Тип операции: Buy (лонг) или Sell (шорт)."
                },
                "usdt_amount": {
                    "type": "number",
                    "description": "Сумма сделки в USDT."
                },
                "take_profit": {
                    "type": "number",
                    "description": "Цена для тейк-профита (Take Profit)."
                },
                "stop_loss": {
                    "type": "number",
                    "description": "Цена для стоп-лосса (Stop Loss)."
                },
                "symbol": {
                    "type": "string",
                    "description": "Валютная пара, например BTCUSDT."
                },
                "order_type": {
                    "type": "string",
                    "enum": ["Limit", "Market"],
                    "description": "Тип ордера: Limit или Market."
                },
                "price": {
                    "type": ["number", "null"],
                    "description": "Цена исполнения (только для Limit ордеров)."
                }
            },
            "required": ["operation_type", "usdt_amount", "take_profit", "stop_loss", "symbol", "order_type"]
        }
    },
    {
        "name": "cancel_order_partial",
        "description": "Отменяет все активные ордера (не исполненные) по заданной валютной паре на Bybit.",
        "parameters": {
            "type": "object",
            "properties": {
                "symbol": {
                    "type": "string",
                    "description": "Торговая пара, по которой нужно отменить все активные ордера (например, 'BTCUSDT', 'ETHUSDT')."
                }
            },
            "required": ["symbol"]
        }
    }
]